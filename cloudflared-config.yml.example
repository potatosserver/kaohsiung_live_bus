# Cloudflare Tunnel 設定檔範例
# 複製到 ~/.cloudflared/config.yml
# 取得 TUNNEL_ID: cloudflared tunnel list

tunnel: <YOUR_TUNNEL_ID>
credentials-file: /home/pi/.cloudflared/<YOUR_TUNNEL_ID>.json

ingress:
  # 主要 API 端點
  - hostname: bus-api.yourdomain.com
    service: http://localhost:8082
    originRequest:
      connectTimeout: 30s
      tcpKeepAlive: 30s
      keepAliveConnections: 10
      keepAliveTimeout: 90s
      noTLSVerify: true

  # 可選: 健康檢查端點單獨域名
  - hostname: bus-health.yourdomain.com
    service: http://localhost:8082/health
    originRequest:
      connectTimeout: 10s

  # 擋掉其他未匹配的請求
  - service: http_status:404

# 可選: 全域設定
# loglevel: info
# transport-loglevel: warn
# metrics: 0.0.0.0:2000  # Prometheus metrics port